---
import { withBase } from '../utils/url';
import { resolveImage } from '../utils/image';

interface Props {
  title: string;
  slug: string;
  date: string;
  description?: string;
  cover?: string;
  sticky?: boolean;
  index?: number;
}

const { title, slug, date, description, cover, sticky, index = 0 } = Astro.props;
const base = import.meta.env.BASE_URL;
const fallbackBase = 'images/random/d-';
const randomIdx = Math.floor(Math.random() * 10) + 1;
const fallbackImg = `${base}${fallbackBase}${randomIdx}.jpg`;
const { src: imgSrc, fallback: fallbackUrl } = resolveImage(cover, base, fallbackImg);
const postUrl = withBase(`/posts/${slug}`, base);

// Odd/even layout class (reference: .post-list-thumb-left for even items)
const isEven = index % 2 === 1;

// Format date as YYYY-MM-DD
const dateObj = new Date(date);
const dateStr = `${dateObj.getFullYear()}-${String(dateObj.getMonth() + 1).padStart(2, '0')}-${String(dateObj.getDate()).padStart(2, '0')}`;
---

<article class:list={[
  "post post-list-thumb",
  { "post-list-thumb-left": isEven }
]} data-post-index={index} itemscope itemtype="http://schema.org/BlogPosting">
  <div class="post-thumb">
    <a href={postUrl}>
      <!-- Layer 1: Solid color placeholder -->
      <div class="img-placeholder" aria-hidden="true"></div>
      <!-- Layer 2: Main image with lazy loading -->
      <img
        class="img-main"
        src={imgSrc}
        alt={title}
        loading="lazy"
        onerror={`this.onerror=null;this.src='${fallbackUrl}'`}
      />
    </a>
  </div>
  <div class="post-content-wrap">
    <div class="post-content">
      <div class="post-date">
        <i class="fa fa-clock-o"></i>发布于 {dateStr}
      </div>
      <a href={postUrl} class="post-title"><h3>{title}</h3></a>
      <div class="post-meta">
        <!-- intentionally left blank; reference uses views/comments, we use whitespace -->
      </div>
      <div class="float-content">
        <p>{description || ''}</p>
        <div class="post-bottom">
          <a href={postUrl} class="button-normal"><i class="fa fa-ellipsis"></i></a>
        </div>
      </div>
    </div>
  </div>
</article>
