---
import { withBase } from "../utils/url";
const base = import.meta.env.BASE_URL;
---

<div class="headertop filter-dot" id="hero-headertop">
  <!--wave-->
  <div id="banner_wave_1"></div>
  <div id="banner_wave_2"></div>
  <!--wave-->
  <figure
    id="centerbg"
    class="centerbg"
    style={`background-image: url('${base}images/hero/LOOPERS PLUS.jpg')`}
  >
    <div class="focusinfo no-select">
      <div class="focusinfo-inner">
        <h1 class="center-text glitch Ubuntu-font" data-text="Meguru's">
          Meguru's
        </h1>
        <h1 class="center-text glitch Ubuntu-font" data-text="Notebook">
          Notebook
        </h1>
      </div>
      <div class="header-info">
        <p>A personal blog with thoughts and ideas</p>
        <ul class="hero-bar">
          <li>
            <a
              href="https://github.com/peiy-meguru"
              target="_blank"
              rel="noopener me"
              title="GitHub"
              aria-label="GitHub"
            >
              <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"
                ><path
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                ></path></svg
              >
            </a>
          </li>
          <li class="hero-bar-center">
            <div class="hero-bar-play" id="video-btn" title="Play / Pause">
              <i class="fa fa-play"></i>
            </div>
          </li>
          <li>
            <a href={withBase("/links", base)} title="Links" aria-label="Links">
              <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"
                ><path
                  d="M6.354 5.5H4a3 3 0 0 0 0 6h3a3 3 0 0 0 2.83-2H9c-.086 0-.17.01-.25.031A2 2 0 0 1 7 10.5H4a2 2 0 1 1 0-4h1.535c.218-.376.495-.714.82-1z"
                ></path><path
                  d="M9.646 10.5H12a3 3 0 0 0 0-6H9a3 3 0 0 0-2.83 2H7c.086 0 .17-.01.25-.031A2 2 0 0 1 9 5.5h3a2 2 0 1 1 0 4H10.465a4.535 4.535 0 0 1-.82 1z"
                ></path></svg
              >
            </a>
          </li>
        </ul>
      </div>
    </div>
  </figure>
  <!-- Video container placeholder (matches reference DOM) -->
  <div id="video-container" style="display: none;"></div>
  <div class="banner-placeholder"></div>
</div>

<div id="video-stage" class="video-stage">
  <div class="video-stage-inner">
    <video
      id="bgvideo"
      class="video"
      src={`${base}videos/LOOPERS PLUS.mp4`}
      poster={`${base}images/hero/LOOPERS PLUS.jpg`}
      width="auto"
      preload="auto"
      muted
      playsinline
    >
    </video>
  </div>
  <div class="video-progress" id="video-progress">
    <div class="video-progress-filled" id="video-progress-filled"></div>
  </div>
</div>
