<div class="changeSkin-gear no-select" id="open-skinMenu">
  <i class="fa fa-palette"></i>
</div>
<div class="gear-top-btn no-select" id="gear-top-btn" title="返回顶部">
  <i class="fa fa-chevron-up"></i>
</div>

<div class="skin-menu no-select">
  <div class="theme-mode-controls row-container">
    <div class="theme-controls-title">主题模式</div>
    <div class="button-group">
      <button type="button" data-mode="system" title="跟随系统">
        <i class="fa fa-desktop"></i><span>系统</span>
      </button>
      <button type="button" data-mode="light" title="浅色">
        <i class="fa fa-sun-o"></i><span>浅色</span>
      </button>
      <button type="button" data-mode="dark" title="深色">
        <i class="fa fa-moon-o"></i><span>深色</span>
      </button>
    </div>
  </div>

  <div class="theme-bg-controls row-container">
    <div class="theme-controls-title">背景</div>
    <div class="button-group">
      <button type="button" data-bg="white" title="白色">
        <i class="fa fa-file"></i><span>白色</span>
      </button>
      <button type="button" data-bg="grid" title="网格">
        <i class="fa fa-th"></i><span>网格</span>
      </button>
      <button type="button" data-bg="slideshow" title="幻灯片">
        <i class="fa fa-image"></i><span>幻灯片</span>
      </button>
    </div>
  </div>

  <div class="font-family-controls row-container">
    <div class="theme-controls-title">字体</div>
    <div class="button-group">
      <button type="button" data-mode="serif">衬线 Serif</button>
      <button type="button" class="selected" data-mode="sans-serif"
        >无衬线 Sans</button
      >
    </div>
  </div>
</div>
