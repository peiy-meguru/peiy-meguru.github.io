---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 - Page Not Found">
  <section class="error-404 not-found">
    <div style="text-align:center; padding:60px 0 30px;">
      <div style="font-size:120px; color:#E67474;">
        <i class="fa fa-face-frown" aria-hidden="true"></i>
      </div>
      <h1 style="font-size:48px; margin:20px 0; color:#666;">404</h1>
    </div>

    <div class="err-button back" style="text-align:center; margin-bottom:30px;">
      <a id="golast" href="javascript:history.go(-1);"
         style="display:inline-block; padding:10px 30px; margin:0 10px;
                border:2px solid #FE9600; border-radius:50px; color:#FE9600;
                font-size:14px; text-decoration:none;
                transition:all .3s;">
        返回上一页
      </a>
      <a id="gohome" href={withBase('/', base)}
         style="display:inline-block; padding:10px 30px; margin:0 10px;
                background:#FE9600; color:#fff; border-radius:50px;
                font-size:14px; text-decoration:none;
                transition:all .3s;
                box-shadow: 0 0 4px rgba(255,165,0,.85);">
        返回主页
      </a>
    </div>

    <div style="display:block; width:284px; margin:auto; padding-bottom:60px;">
      <p style="margin-bottom:1em; margin-top:1.5em; text-align:center; font-size:15px; color:#9C9C9C;">
        别急，试试站内搜索？
      </p>
      <form class="s-search" action={withBase('/', base)} role="search" style="position:relative;">
        <i class="fa fa-search" style="position:absolute; bottom:10px; left:12px; color:#999;"></i>
        <input
          class="text-input"
          style="width:100%; padding:8px 20px 8px 46px; border:1px solid #ddd; border-radius:30px; font-size:14px; outline:none; box-sizing:border-box;"
          type="search"
          name="s"
          placeholder="Search..."
          required
        />
      </form>
    </div>
  </section>
</BaseLayout>
