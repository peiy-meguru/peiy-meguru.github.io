---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/site.json';
import { withBase } from '../utils/url';

const base = import.meta.env.BASE_URL;

const links = [
  { name: 'Mashiro', url: 'https://2heng.xin', desc: 'Sakura 主题原作者', avatar: '/images/avatars/avatar mashiro.jpg' },
];
const links_related = [
  { name: 'Astro', url: 'https://astro.build', desc: '静态站点生成器', avatar: 'https://avatars.githubusercontent.com/u/44914786?s=200&v=4' },
];
---

<BaseLayout title={`友链 - ${siteData.name}`}>
  <article class="page">
    <header class="entry-header">
      <h1 class="page-title mb-">友链</h1>
    </header>

    <div class="entry-content links">
      <p style="color:#797979; line-height:30px;">这里是友情链接页面。欢迎交换友链！</p>

      <ul>
        {links.map(link => (
          <li>
            <a href={link.url} target="_blank" rel="noopener">
              <span class="sitename">{link.name}</span>
              <div class="linkdes">{link.desc}</div>
              <img src={withBase(link.avatar, base)} alt={link.name} loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="entry-content links">
      <p style="color:#797979; line-height:30px;">这里是相关链接页面，以供参考。</p>

      <ul>
        {links_related.map(link_related => (
          <li>
            <a href={link_related.url} target="_blank" rel="noopener">
              <span class="sitename">{link_related.name}</span>
              <div class="linkdes">{link_related.desc}</div>
              <img src={withBase(link_related.avatar, base)} alt={link_related.name} loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </article>
</BaseLayout>
<style>
  .links {
    margin-bottom: 80px;
  }

  .links ul {
    margin: 0;
    list-style: none;
    padding: 0;
    width: 100%;
    display: inline-block;
  }

  .links ul li {
    width: 32%;
    float: left;
    border: 1px solid #ECECEC;
    padding: 10px 30px;
    margin: 4px 4px;
    position: relative;
    overflow: hidden;
    -webkit-transition: all .3s;
    transition: all .3s;
    border-radius: 10px;
  }

  .links ul li img {
    float: right;
    box-shadow: inset 0 0 10px #000;
    padding: 5px;
    opacity: 1;
    transform: rotate(0);
    -webkit-transform: rotate(0);
    -moz-transform: rotate(0);
    -o-transform: rotate(0);
    -ms-transform: rotate(0);
    transition: all ease 1s;
    -webkit-transition: all ease 1s;
    -moz-transition: all ease 1s;
    -o-transition: all ease 1s;
    margin-top: 5px;
    width: 65px;
    height: 65px;
    padding: 2px;
    border-radius: 100%;
    object-fit: cover;
  }

  .links ul li:hover img {
    transform: rotate(360deg);
    -webkit-transform: rotate(360deg);
    -moz-transform: rotate(360deg);
    -o-transform: rotate(360deg);
    -ms-transform: rotate(360deg);
  }

  span.sitename {
    color: orange;
    padding-bottom: 10px;
    display: block;
    font-size: 14px;
    -webkit-transition: all .3s;
    transition: all .3s;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .linkdes {
    color: #949494;
    font-size: 13px;
    padding-top: 5px;
  }

  .links ul li:hover {
    box-shadow: 0 2px 14px rgba(0, 0, 0, .15);
  }

  @media (max-width: 860px) {
    .links ul li {
      width: 47%;
    }
  }

  @media (max-width: 600px) {
    .links ul li {
      width: 100%;
      float: none;
      margin: 8px 0;
    }
  }
</style>
