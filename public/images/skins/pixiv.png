<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <pattern id="stars" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
      <rect width="60" height="60" fill="#1a1a2e"/>
      <circle cx="10" cy="10" r="1.5" fill="#fff" opacity="0.7"/>
      <circle cx="30" cy="25" r="1" fill="#fff" opacity="0.5"/>
      <circle cx="50" cy="15" r="1.5" fill="#fff" opacity="0.6"/>
      <circle cx="20" cy="45" r="1" fill="#fff" opacity="0.4"/>
      <circle cx="45" cy="50" r="1.5" fill="#fff" opacity="0.7"/>
    </pattern>
  </defs>
  <rect width="200" height="200" fill="url(#stars)"/>
</svg>
