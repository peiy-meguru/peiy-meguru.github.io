<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <pattern id="totem" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
      <rect width="40" height="40" fill="#fff8f0"/>
      <circle cx="20" cy="20" r="10" fill="#FF9800" opacity="0.1"/>
      <circle cx="20" cy="20" r="5" fill="#FF9800" opacity="0.15"/>
    </pattern>
  </defs>
  <rect width="100" height="100" fill="url(#totem)"/>
</svg>
